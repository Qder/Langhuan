{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "琅嬛",
  "version": "0.1.0",
  "identifier": "com.qder.langhuan",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run desktop:dev-server",
    "beforeBuildCommand": "npm run desktop:ui"
  },
  "app": {
    "windows": [
      {
        "title": "琅嬛",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGQzMzMzlBNTQ3NDMyQUUKUldTdU1uUlVtalBEUDFPRlRTSExZVlhhS2NBTnUyU1hmM01RUkUxN3VPT2VhWkxSeEdrNG1xQ1IK",
      "endpoints": [
        "https://github.com/Qder/Langhuan/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
