# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
.vscode
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Runtime logs (dev server output, tool traces). Never product source.
*.log

# Ad-hoc debugging screenshots written to the repo root while iterating on
# chrome/spacing. Real assets belong in public/ or the note folder.
/*.png
/*.jpg
/*.jpeg

# Local repro / scratch scripts (not part of the build)
/scripts/_bq-*
/scripts/_repro-*

# env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# tauri (legacy)
/src-tauri/target

# Local library (source of truth on disk; do not commit user notes)
/content/**
!/content/.gitkeep
!/content/.langhuan/
/content/.langhuan/**
!/content/.langhuan/.gitkeep
